# OSRM data
OSRM_TOLL_PATH=/path/to/repo/.data/osrm/toll
OSRM_OPTIMAL_PATH=/path/to/repo/.data/osrm/optimal

# Use another deployment's routers, for example https://<lender>/api/osrm/toll.
OSRM_TOLL_URL=
OSRM_OPTIMAL_URL=
# Sent as X-Auth to the routers. Set it to lend this deployment's routers under /api/osrm/.
OSRM_ACCESS_TOKEN=

# Extract from https://www.vinci-autoroutes.com/fr/ using your browser's Developer tools
ULYS_SUBSCRIPTION_KEY=

# Extract toll prices at this date
ULYS_PASSAGE_DATE=2026-08-24T12:00:00.0Z

URL=https://french-tolls.undiscoveredlatitudes.com
TELEGRAM_BOT_TOKEN=
# Autocomplete https://locationiq.com/
LOCATIONIQ_API_KEY=
# Needs "Direction API" enabled
GOOGLE_DIRECTIONS_API_KEY=
# Free tier is 10000
GOOGLE_DIRECTIONS_MAX_REQUEST_PER_MONTH=0

# OSRM's travel time is multiplied by this before being served (it's usually overestimated).
TIME_MULTIPLIER=0.9333

# What a driver's hour is worth
EUR_PER_HOUR=20

DEBUG=0
LOG_LEVEL=INFO
